{
  "version": 1,
  "default_preset": "default",
  "presets": {
    "default": {
      "description": "默认命名规范：类型/日期-需求编号-英文描述",
      "max_length": 64,
      "fields": {
        "type": {
          "source": "input",
          "required": true,
          "processor": {
            "type": "mapping",
            "mappings": {
              "feature": "feature",
              "feat": "feature",
              "功能": "feature",
              "需求": "feature",
              "新功能": "feature",
              "enhancement": "feature",
              "优化": "feature",
              "bugfix": "fix",
              "fix": "fix",
              "bug": "fix",
              "缺陷": "fix",
              "修复": "fix",
              "hotfix": "hotfix",
              "紧急修复": "hotfix",
              "release": "release",
              "发布": "release",
              "chore": "chore",
              "杂务": "chore",
              "docs": "docs",
              "文档": "docs",
              "refactor": "refactor",
              "重构": "refactor",
              "test": "test",
              "测试": "test",
              "ci": "ci",
              "style": "style",
              "perf": "perf",
              "性能": "perf",
              "build": "build"
            }
          },
          "normalize": "slug"
        },
        "date": {
          "source": "datetime",
          "required": true,
          "processor": {
            "type": "transform",
            "format": "%Y%m%d"
          }
        },
        "id": {
          "source": "input",
          "required": true,
          "processor": {
            "type": "passthrough"
          },
          "normalize": "token"
        },
        "description": {
          "source": "input",
          "required": true,
          "processor": {
            "type": "llm",
            "operation": "semantic-slug",
            "options": {
              "language": "en",
              "max_words": 10
            }
          },
          "normalize": "slug"
        }
      },
      "template": "{type}/{date}-{id}-{description}"
    },
    "conventional": {
      "description": "Conventional Commits 风格：type/英文描述",
      "max_length": 64,
      "fields": {
        "type": {
          "source": "input",
          "required": true,
          "processor": {
            "type": "mapping",
            "mappings": {
              "feature": "feat",
              "feat": "feat",
              "功能": "feat",
              "需求": "feat",
              "新功能": "feat",
              "enhancement": "feat",
              "优化": "feat",
              "bugfix": "fix",
              "fix": "fix",
              "bug": "fix",
              "缺陷": "fix",
              "修复": "fix",
              "hotfix": "fix",
              "紧急修复": "fix",
              "release": "release",
              "发布": "release",
              "chore": "chore",
              "杂务": "chore",
              "docs": "docs",
              "文档": "docs",
              "refactor": "refactor",
              "重构": "refactor",
              "test": "test",
              "测试": "test",
              "ci": "ci",
              "style": "style",
              "perf": "perf",
              "性能": "perf",
              "build": "build"
            }
          },
          "normalize": "slug"
        },
        "description": {
          "source": "input",
          "required": true,
          "processor": {
            "type": "llm",
            "operation": "semantic-slug",
            "options": {
              "language": "en",
              "max_words": 10
            }
          },
          "normalize": "slug"
        }
      },
      "template": "{type}/{description}"
    },
    "gitflow": {
      "description": "GitFlow 风格：feature/英文描述",
      "max_length": 64,
      "fields": {
        "type": {
          "source": "input",
          "required": true,
          "processor": {
            "type": "mapping",
            "mappings": {
              "feature": "feature",
              "feat": "feature",
              "功能": "feature",
              "需求": "feature",
              "新功能": "feature",
              "enhancement": "feature",
              "优化": "feature",
              "bugfix": "bugfix",
              "fix": "bugfix",
              "bug": "bugfix",
              "缺陷": "bugfix",
              "修复": "bugfix",
              "hotfix": "hotfix",
              "紧急修复": "hotfix",
              "release": "release",
              "发布": "release",
              "chore": "chore",
              "杂务": "chore",
              "docs": "docs",
              "文档": "docs",
              "refactor": "refactor",
              "重构": "refactor",
              "test": "test",
              "测试": "test",
              "ci": "ci",
              "style": "style",
              "perf": "perf",
