            "options": {
              "language": "en",
              "max_words": 10
            }
          },
          "normalize": "slug"
        }
      },
      "template": "{type}/{description}"
    },
    "simple": {
      "description": "简洁命名规范：仅英文描述",
      "max_length": 64,
      "fields": {
        "description": {
          "source": "input",
          "required": true,
          "processor": {
            "type": "llm",
            "operation": "semantic-slug",
            "options": {
              "language": "en",
              "max_words": 10
            }
          },
          "normalize": "slug"
        }
      },
      "template": "{description}"
    }
  }
}
